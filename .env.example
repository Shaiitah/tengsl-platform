# Скопируй в .env рядом с docker-compose.yml и отредактируй под себя.
# Режим development/production переключается из Dashboard; Docker socket не нужен.

ORION_DATABASE_URL=postgresql+asyncpg://tengsl:tengsl@postgres:5432/tengsl
ORION_MQTT_HOST=mqtt-broker
ORION_MQTT_PORT=1883
ORION_MQTT_USE_TLS=false
ORION_MQTT_USERNAME=
ORION_MQTT_PASSWORD=
ORION_MQTT_TOPIC_PREFIX=tengsl
ORION_CORS_ALLOW_ORIGINS=https://morianas.ru,http://localhost:8080

POSTGRES_USER=tengsl
POSTGRES_PASSWORD=tengsl
POSTGRES_DB=tengsl

# Public URL. Change this one value when deploying to another domain.
ORION_PUBLIC_BASE_URL=https://morianas.ru

# ntfy notifications
ORION_NTFY_ENABLED=true
ORION_NTFY_BASE_URL=http://ntfy:80
ORION_NTFY_PUBLIC_URL=https://ntfy.morianas.ru
ORION_NTFY_PUBLISHER_TOKEN=tk_tengslpublisher00000000000000
ORION_NTFY_TOPIC_SECRET=change-me-to-a-long-random-secret
NTFY_BASE_URL=https://ntfy.morianas.ru
NTFY_PUBLISHER_TOKEN=tk_tengslpublisher00000000000000

# Optional: absolute path to an external test_results.json. Leave empty to show "Не запускались".
ORION_TEST_RESULTS_PATH=

# Shared secret for Edge Agent -> Backend read-only object API
TENGSL_AGENT_API_TOKEN=change-me-to-a-long-random-agent-token
